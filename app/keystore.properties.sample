# Copy this file to "keystore.properties" (same folder) and fill in real
# values. keystore.properties itself is gitignored — never commit it or the
# .jks/.keystore file it points to.
#
# Create a release keystore first, e.g.:
#   keytool -genkeypair -v -keystore csocsomaster-release.jks -alias csocsomaster -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the app/ directory.
storeFile=csocsomaster-release.jks
storePassword=CHANGE_ME
keyAlias=csocsomaster
keyPassword=CHANGE_ME
